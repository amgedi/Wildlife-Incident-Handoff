{
  "name": "wildlife-incident-handoff",
  "private": true,
  "version": "0.3.0-rc.2",
  "description": "An open-source, local-first tool for creating clear and traceable wildlife incident handoffs.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "set-version": "node scripts/set-version.mjs",
    "prebuild": "node scripts/gen-build-identity.mjs",
    "desktop:release": "node scripts/desktop-release.mjs",
    "release:all": "node scripts/release-all.mjs",
    "postbuild": "node scripts/fix-maplibre-worker.mjs",
    "launcher:build": "cd launcher/ui && npx vite build && cd ../../launcher/src-tauri && cargo build --release",
    "launcher:deploy": "npm run launcher:build && node -e \"require('fs').copyFileSync('launcher/src-tauri/target/release/wih-launcher.exe', 'Launch Wildlife Incident Handoff.exe')\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "i18next": "^26.4.3",
    "idb": "^8.0.4",
    "libphonenumber-js": "^1.13.15",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
