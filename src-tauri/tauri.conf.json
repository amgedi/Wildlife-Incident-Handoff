{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wildlife Incident Handoff",
  "version": "0.2.0-dev.7",
  "identifier": "org.wildlifeincidenthandoff.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wildlife Incident Handoff",
        "width": 1180,
        "height": 760,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon-512.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "shortDescription": "Clear information. Safer handoffs.",
    "longDescription": "An open-source, local-first tool for creating clear and traceable wildlife incident handoffs."
  }
}
